      "name": "If"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are evaluating an incoming cold email reply from Instantly.ai.\n\nINCOMING REPLY:\nFrom: {{ $json.body.lead_email }}\nCompany: {{ $json.body.company_name }}\nReply Text: {{ $json.body.reply_text }}\n\nDetermine if this reply is a positive response, meeting request, coffee chat invite, or expression of interest.\n\nReturn strictly raw JSON (no markdown wrapping):\n{\n  \"isPositiveOpportunity\": true,\n  \"summary\": \"<1-sentence summary of what the prospect said>\",\n  \"urgency\": \"High\"\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        256,
        0
      ],
      "id": "e728688e-4d00-49d9-bdc8-4331840d181e",
      "name": "Filter Positive Responses",
      "retryOnFail": false,
      "alwaysOutputData": false,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const rawText = item.json.text || item.json.output || '';\n  const cleanedText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\n\n  try {\n    const parsed = JSON.parse(cleanedText);\n    item.json.isPositiveOpportunity = parsed.isPositiveOpportunity ?? false;\n    item.json.summary = parsed.summary || 'No summary provided.';\n    item.json.urgency = parsed.urgency || 'Low';\n  } catch (e) {\n    item.json.isPositiveOpportunity = false;\n    item.json.summary = 'Failed to parse reply text.';\n    item.json.urgency = 'Low';\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "id": "a2d3f9b9-6ac2-4390-9258-b821797c4746",
      "name": "Parse JSON"
    },
    {
